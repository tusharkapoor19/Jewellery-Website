PORT=5006
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/jewelleryDB

# Comma separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:3000

# Must match the JWT_SECRET used by auth-services / user-services - this
# service verifies the same admin Bearer token issued by auth-services
# (see middleware/authMidd.js). Without this, every admin-only route
# (stats/summary, PATCH, DELETE, admin chat reply) fails with 401 even for
# a valid, logged-in admin - which was breaking the admin Custom Design tab.
JWT_SECRET=mysecretkey
